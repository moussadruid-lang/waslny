{
  "name": "mashawir",
  "private": true,
  "description": "مشاوير — نوصلها لك. Delivery platform for Egypt.",
  "workspaces": ["packages/*", "apps/*"],
  "scripts": {
    "dev": "npm run dev -w @mashawir/api",
    "dashboard": "npm run dev -w @mashawir/dashboard",
    "build:dashboard": "npm run build -w @mashawir/dashboard",
    "worker": "npm run worker -w @mashawir/api",
    "customer": "npm start -w @mashawir/mobile-customer",
    "driver": "npm start -w @mashawir/mobile-driver",
    "test": "npm test -w @mashawir/domain && npm test -w @mashawir/api",
    "test:domain": "npm test -w @mashawir/domain",
    "typecheck:mobile": "npm run typecheck -w @mashawir/mobile-customer && npm run typecheck -w @mashawir/mobile-driver",
    "typecheck:dashboard": "npm run typecheck -w @mashawir/dashboard"
  },
  "engines": { "node": ">=22.6" }
}
