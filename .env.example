# Copy to apps/api/.env — NEVER commit real secrets. Use separate values per environment.
NODE_ENV=development            # development | staging | production
PORT=4000
DATABASE_URL=postgresql://mashawir:mashawir@localhost:5432/mashawir_dev
REDIS_URL=redis://localhost:6379
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_ACCESS_TTL=15m
REFRESH_TTL_DAYS=30
OTP_PEPPER=change-me-random-16+
CORS_ORIGINS=http://localhost:3000,http://localhost:8081
PUBLIC_TRACKING_BASE_URL=http://localhost:3000/track
UPLOAD_DIR=./storage/uploads    # local disk in dev; swap FileStorage to S3/R2 in prod
PUBLIC_FILES_BASE_URL=http://localhost:4000/files  # on a phone use your LAN IP, e.g. http://192.168.1.10:4000/files
SMS_PROVIDER=console            # console (dev only, blocked in prod) | cequens | vonage | twilio
MAPS_PROVIDER=haversine         # haversine | osrm | google | mapbox
MAPS_API_KEY=
OSRM_URL=
PUSH_PROVIDER=expo              # none | expo | fcm
SENTRY_DSN=
SUPER_ADMIN_PHONE=+2010XXXXXXXX # bootstrap admin on first seed
